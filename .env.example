# ─────────────────────────────────────────────────────────────────────────────
# G-SANTÉ — modèle de configuration. Copier en .env puis adapter (voir README).
# Ne jamais versionner le fichier .env réel.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="G-SANTE"
APP_ENV=local
APP_KEY=
# SEC-05 : toujours false en production
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de travail (MySQL 8 ou MariaDB 10.6+). Les tests utilisent une base
# distincte, gsante_test, déclarée dans phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gsante
DB_USERNAME=root
DB_PASSWORD=

# SEC-02 : déconnexion après inactivité (minutes)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SEC-05 : true dès que le site est servi en HTTPS
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Sauvegardes (ENF-05, SEC-09) ─────────────────────────────────────────────
# Dossier contenant mysqldump (XAMPP : /opt/lampp/bin ; laisser vide s'il est dans le PATH)
DB_DUMP_BINARY_PATH=
BACKUP_NAME=g-sante
# Supports de copie : local (storage/app/private) et sauvegarde_externe (disque externe ou NAS)
BACKUP_DISKS=local
BACKUP_EXTERNAL_PATH=
# Mot de passe de chiffrement des archives (fortement recommandé en production)
BACKUP_ARCHIVE_PASSWORD=
# Canaux de notification des sauvegardes (vide = journal uniquement ; ex. mail)
BACKUP_NOTIFICATIONS=
BACKUP_MAIL_TO=

# ── SMS (EF-03.05) : journal par défaut ; passerelle HTTP à configurer ───────
# Rôle de l'installation : local (serveur d'établissement) ou en_ligne (espace patient, synchronisation)
GSANTE_MODE=local

SMS_PILOTE=journal
SMS_HTTP_URL=
SMS_HTTP_JETON=
SMS_EXPEDITEUR=G-SANTE
